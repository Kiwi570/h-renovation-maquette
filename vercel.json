{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/merci-contact",
      "destination": "/contact",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/servicetype/:c(fa.*ade)",
      "destination": "/servicetype/facade"
    },
    {
      "source": "/services/:s(d.*moussage-toiture)",
      "destination": "/services/demoussage-toiture"
    },
    {
      "source": "/services/:s(r.*fection-toiture)",
      "destination": "/services/refection-toiture"
    },
    {
      "source": "/services/:s(goutti.*re)",
      "destination": "/services/gouttiere"
    },
    {
      "source": "/services/:s(hydrofuge-fa.*ade)",
      "destination": "/services/hydrofuge-facade"
    },
    {
      "source": "/services/:s(d.*moussage-fa.*ade)",
      "destination": "/services/demoussage-facade"
    },
    {
      "source": "/services/:s(nettoyage-fa.*ade)",
      "destination": "/services/nettoyage-facade"
    },
    {
      "source": "/services/:s(ravalement-de-fa.*ade)",
      "destination": "/services/ravalement-de-facade"
    },
    {
      "source": "/services/:s(rev.*tement-de-fa.*ade)",
      "destination": "/services/revetement-de-facade"
    },
    {
      "source": "/services/:s(traitement-d.*humidit.*)",
      "destination": "/services/traitement-humidite"
    },
    {
      "source": "/services/:s(remont.*es-capillaires)",
      "destination": "/services/remontees-capillaires"
    },
    {
      "source": "/services/:s(salp.*tre)",
      "destination": "/services/salpetre"
    },
    {
      "source": "/services/:s(infiltrations-d.*eau)",
      "destination": "/services/infiltrations-eau"
    },
    {
      "source": "/services/:s(isolation-thermique-int.*rieure)",
      "destination": "/services/isolation-thermique-interieure"
    },
    {
      "source": "/services/:s(isolation-thermique-ext.*rieure)",
      "destination": "/services/isolation-thermique-exterieure"
    },
    {
      "source": "/services/:s(combles-am.*nageables)",
      "destination": "/services/combles-amenageables"
    }
  ]
}
